{
  "name": "sightread",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/create-icons.mjs && vite",
    "build": "node scripts/create-icons.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "nvidia-proxy": "node server/nvidia-proxy.mjs",
    "search-proxy": "node server/search-proxy.mjs",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250617.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10",
    "wrangler": "^4.24.0"
  }
}
